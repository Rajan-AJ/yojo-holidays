# Copy to .env.local (Next.js) and .env (Prisma CLI). Never commit real values.

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/yojo_holidays?schema=public"
# Only needed by `prisma migrate dev` if your database user cannot create a shadow database
SHADOW_DATABASE_URL=""

# Max database connections per server process (keep low for `prisma dev`)
DATABASE_POOL_MAX="10"

# Optional: cap build workers (e.g. "1" with the local `prisma dev` database)
NEXT_BUILD_CPUS=""

# Show development sample content (isSample) in production builds.
# "true" only on local/staging. Never on the live site.
SHOW_SAMPLE_CONTENT="false"

# Public site URL, no trailing slash. Used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Set to "true" only on the live production domain. Anything else is noindex.
NEXT_PUBLIC_ALLOW_INDEXING="false"

# Analytics (Phase 13). Leave empty to disable.
NEXT_PUBLIC_GTM_ID=""

# Admin session signing secret (Phase 11). Generate with: openssl rand -base64 32
SESSION_SECRET=""
