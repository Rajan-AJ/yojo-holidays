# Copy to .env.local. Never commit real values.

# --- Database ---------------------------------------------------------------
# Local development (npm run db:local):
#   postgresql://postgres:postgres@127.0.0.1:54322/postgres?sslmode=disable
# Supabase: Project Settings -> Database -> Connection string -> "Transaction pooler"
#   (port 6543). Server-only: never prefix with NEXT_PUBLIC_.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres?sslmode=disable"

# Max database connections per server process. Keep low for the local database
# and for serverless hosting (each function instance opens its own pool).
DATABASE_POOL_MAX="5"

# Optional: cap build workers (e.g. "1" with the local database)
NEXT_BUILD_CPUS=""

# --- Supabase ---------------------------------------------------------------
# Project URL (Settings -> API). Public: used to build Storage image URLs.
NEXT_PUBLIC_SUPABASE_URL=""
# anon / publishable key (Settings -> API). Public by design: RLS protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# service_role key. SERVER ONLY, bypasses RLS. Never expose, never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Site -------------------------------------------------------------------
# Show development sample content (is_sample) in production builds.
# "true" only on local/staging. Never on the live site.
SHOW_SAMPLE_CONTENT="false"

# Public site URL, no trailing slash. Used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Set to "true" only on the live production domain. Anything else is noindex.
NEXT_PUBLIC_ALLOW_INDEXING="false"

# Google Tag Manager container (Google Ads + Meta conversion tags live there).
# The site pushes a `generate_lead` event on the thank-you page. Empty = disabled.
NEXT_PUBLIC_GTM_ID=""
