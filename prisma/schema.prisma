// Yojo Holidays - data model (Phase 3: database + content architecture)
//
// Content graph:
//   Region -> Country -> Destination -> TourPackage -> ItineraryDay / PackageHotel -> Hotel
//   Country (destination) + Country (passport) -> VisaCountry -> VisaType -> VisaRequirement (documents)
//                                                                           -> VisaProcessStep (how to apply)
//   Destination / Country -> TravelGuide
//   FAQ attaches to exactly one owner (package, destination, country, guide, visa country, visa type)
//   or to none (site-wide FAQ page / homepage).
//
// Principles:
// - Public URLs use slugs only; ids never appear in URLs.
// - Every public content entity has a PublishStatus and an optional one-to-one SeoMeta row.
// - Images are Media rows referenced by id, so alt text lives in one place.
// - `isSample` marks development seed data. It is excluded from public queries in
//   production (see src/server/repositories/shared.ts) and can be purged before launch.
// - Database CHECK constraints (in the migration SQL) back up app-level validation
//   for ratings, durations, prices and FAQ ownership.
//
// The database URL is configured in prisma.config.ts (Prisma 7 style).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN // full access, including users and settings
  EDITOR // content + leads, no user management
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Drives the URL segment: /domestic-tours/... or /international-tours/...
enum TourScope {
  DOMESTIC
  INTERNATIONAL
}

enum DestinationType {
  COUNTRY // Vietnam
  REGION // Kerala, Northern Vietnam
  CITY // Hanoi, Tokyo
  PLACE // Ha Long Bay, Mount Fuji
}

enum VisaPurpose {
  TOURISM
  BUSINESS
  TRANSIT
  FAMILY_VISIT
}

/// What kind of permission a visa type is (shown as "Visa required?").
enum VisaEligibilityKind {
  VISA_FREE
  VISA_ON_ARRIVAL
  E_VISA
  ETA
  VISA_REQUIRED
}

enum GuideCategory {
  DESTINATION_GUIDE
  VISA_GUIDE
  TRAVEL_TIPS
  THINGS_TO_DO
  BEST_TIME_TO_VISIT
  TRAVEL_COST_GUIDE
  TRAVEL_FAQ
}

enum FaqPlacement {
  DEFAULT // shown with its owner (or on the FAQ page when it has none)
  HOMEPAGE // also shown on the homepage
  VISA // general visa questions, shown on /visa/
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  CONFIRMED
  LOST
}

enum EnquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  SPAM
}

// ---------------------------------------------------------------------------
// Auth / admin (authentication itself arrives in a later phase)
// ---------------------------------------------------------------------------

// One User model covers admins and editors via `role`. Guide authors are Users.
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         UserRole  @default(EDITOR)
  isActive     Boolean   @default(true)
  bio          String? // public author bio for guides (E-E-A-T / GEO)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions Session[]
  guides   TravelGuide[]
}

// Server-side sessions. The cookie only holds an opaque token; we store its hash.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Media + SEO (shared by all content)
// ---------------------------------------------------------------------------

model Media {
  id         String   @id @default(cuid())
  url        String
  storageKey String? // key in object storage (e.g. Vercel Blob / S3)
  altText    String // required: every image needs a description
  title      String?
  caption    String?
  credit     String?
  width      Int?
  height     Int?
  mimeType   String?
  sizeBytes  Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  regions           Region[]           @relation("RegionImage")
  countries         Country[]          @relation("CountryImage")
  destinations      Destination[]      @relation("DestinationImage")
  destinationImages DestinationImage[]
  categories        TourCategory[]     @relation("CategoryImage")
  packages          TourPackage[]      @relation("PackageImage")
  packageImages     PackageImage[]
  itineraryDays     ItineraryDay[]
  hotels            Hotel[]
  visaCountries     VisaCountry[]
  guides            TravelGuide[]
  reviews           Review[]
  seoMeta           SeoMeta[]
}

// Optional per-page SEO overrides. One row per content entity (one-to-one).
// When absent, pages derive title/description from the content itself.
model SeoMeta {
  id              String   @id @default(cuid())
  seoTitle        String?
  metaDescription String?
  canonicalUrl    String? // only when it differs from the page's own URL
  ogTitle         String?
  ogDescription   String?
  ogImageId       String?
  noIndex         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ogImage Media? @relation(fields: [ogImageId], references: [id], onDelete: SetNull)

  region      Region?
  country     Country?
  destination Destination?
  category    TourCategory?
  package     TourPackage?
  visaCountry VisaCountry?
  guide       TravelGuide?
}

// ---------------------------------------------------------------------------
// Geography
// ---------------------------------------------------------------------------

// Asia, Southeast Asia (parent: Asia), Middle East, Europe, India...
model Region {
  id          String        @id @default(cuid())
  name        String        @unique
  slug        String        @unique
  description String?
  parentId    String?
  imageId     String?
  sortOrder   Int           @default(0)
  status      PublishStatus @default(DRAFT)
  seoId       String?       @unique
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  parent    Region?   @relation("RegionTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Region[]  @relation("RegionTree")
  image     Media?    @relation("RegionImage", fields: [imageId], references: [id], onDelete: SetNull)
  seo       SeoMeta?  @relation(fields: [seoId], references: [id], onDelete: SetNull)
  countries Country[]

  @@index([parentId])
  @@index([status, sortOrder])
}

model Country {
  id               String        @id @default(cuid())
  name             String        @unique
  slug             String        @unique // also the visa URL: /visa/{slug}/
  isoCode          String        @unique @db.Char(2) // ISO 3166-1 alpha-2
  regionId         String
  shortDescription String?
  description      String?
  featuredImageId  String?
  status           PublishStatus @default(DRAFT)
  seoId            String?       @unique
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  region             Region        @relation(fields: [regionId], references: [id], onDelete: Restrict)
  featuredImage      Media?        @relation("CountryImage", fields: [featuredImageId], references: [id], onDelete: SetNull)
  seo                SeoMeta?      @relation(fields: [seoId], references: [id], onDelete: SetNull)
  destinations       Destination[]
  hotels             Hotel[]
  demonym            String? // "Indian": used in "Vietnam Visa for Indian Travellers"
  visaGuides         VisaCountry[] @relation("VisaDestination") // visa info FOR travelling to this country
  passportVisaGuides VisaCountry[] @relation("VisaPassport") // visa info for holders of this passport
  guides             TravelGuide[]
  faqs               FAQ[]

  @@index([regionId])
  @@index([status])
}

// What travellers browse: a whole country, a region, a city or a specific place.
// URL: /{scope}-tours/{slug}/  (slug is globally unique)
model Destination {
  id               String          @id @default(cuid())
  name             String
  slug             String          @unique
  type             DestinationType
  scope            TourScope
  countryId        String
  parentId         String? // Hanoi -> Vietnam
  shortDescription String? // card / answer-first summary
  description      String?
  bestTimeToVisit  String?
  averageDuration  String? // e.g. "6 to 8 days"
  featuredImageId  String?
  isFeatured       Boolean         @default(false)
  isSample         Boolean         @default(false)
  sortOrder        Int             @default(0)
  status           PublishStatus   @default(DRAFT)
  seoId            String?         @unique
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  country       Country            @relation(fields: [countryId], references: [id], onDelete: Restrict)
  parent        Destination?       @relation("DestinationTree", fields: [parentId], references: [id], onDelete: SetNull)
  children      Destination[]      @relation("DestinationTree")
  featuredImage Media?             @relation("DestinationImage", fields: [featuredImageId], references: [id], onDelete: SetNull)
  seo           SeoMeta?           @relation(fields: [seoId], references: [id], onDelete: SetNull)
  gallery       DestinationImage[]
  related       Destination[]      @relation("RelatedDestinations")
  relatedBy     Destination[]      @relation("RelatedDestinations")
  packages      TourPackage[]
  itineraryDays ItineraryDay[]
  guides        TravelGuide[]
  faqs          FAQ[]
  reviews       Review[]

  @@index([countryId])
  @@index([parentId])
  @@index([scope, status])
  @@index([isFeatured, status])
}

model DestinationImage {
  id            String @id @default(cuid())
  destinationId String
  mediaId       String
  sortOrder     Int    @default(0)

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  media       Media       @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([destinationId, mediaId])
}

// ---------------------------------------------------------------------------
// Tours
// ---------------------------------------------------------------------------

// Travel styles: Family, Honeymoon, Group, Senior Citizen, Women's, Luxury, Custom.
// Domestic/International is NOT a category: it comes from Destination.scope,
// so a package can never be filed under the wrong one.
model TourCategory {
  id          String        @id @default(cuid())
  name        String        @unique
  slug        String        @unique // /tours/{slug}/
  description String?
  imageId     String?
  sortOrder   Int           @default(0)
  status      PublishStatus @default(DRAFT)
  seoId       String?       @unique
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  image    Media?        @relation("CategoryImage", fields: [imageId], references: [id], onDelete: SetNull)
  seo      SeoMeta?      @relation(fields: [seoId], references: [id], onDelete: SetNull)
  packages TourPackage[] // many-to-many: a trip can be Family AND Group

  @@index([status, sortOrder])
}

model TourPackage {
  id               String        @id @default(cuid())
  name             String
  slug             String // unique within its destination: /international-tours/vietnam/{slug}/
  destinationId    String
  shortDescription String? // card summary
  description      String?
  durationDays     Int
  durationNights   Int
  startingPrice    Decimal?      @db.Decimal(12, 2) // per person; null = "price on request"
  currency         String        @default("INR") @db.Char(3)
  priceNote        String? // e.g. "per person, twin sharing"
  importantInfo    String?
  featuredImageId  String?
  visaCountryId    String? // links the package to the relevant visa page
  isFeatured       Boolean       @default(false)
  isSample         Boolean       @default(false)
  sortOrder        Int           @default(0)
  status           PublishStatus @default(DRAFT)
  publishedAt      DateTime?
  seoId            String?       @unique
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  destination   Destination        @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  featuredImage Media?             @relation("PackageImage", fields: [featuredImageId], references: [id], onDelete: SetNull)
  visaCountry   VisaCountry?       @relation(fields: [visaCountryId], references: [id], onDelete: SetNull)
  seo           SeoMeta?           @relation(fields: [seoId], references: [id], onDelete: SetNull)
  categories    TourCategory[]
  gallery       PackageImage[]
  highlights    PackageHighlight[]
  itineraryDays ItineraryDay[]
  hotels        PackageHotel[]
  inclusions    PackageInclusion[]
  exclusions    PackageExclusion[]
  faqs          FAQ[]
  reviews       Review[]
  leads         Lead[]

  @@unique([destinationId, slug])
  @@index([status, isFeatured])
  @@index([status, publishedAt])
}

model PackageImage {
  id        String @id @default(cuid())
  packageId String
  mediaId   String
  sortOrder Int    @default(0)

  package TourPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  media   Media       @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([packageId, mediaId])
}

model PackageHighlight {
  id          String  @id @default(cuid())
  packageId   String
  title       String // "Overnight Ha Long Bay cruise"
  description String?
  icon        String? // optional visual identifier, e.g. "cruise"
  sortOrder   Int     @default(0)

  package TourPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId, sortOrder])
}

// One row per day. dayNumber is unique within a package and orders the days.
model ItineraryDay {
  id                  String   @id @default(cuid())
  packageId           String
  dayNumber           Int
  title               String
  description         String?
  morningActivities   String?
  afternoonActivities String?
  eveningActivities   String?
  breakfast           Boolean  @default(false)
  lunch               Boolean  @default(false)
  dinner              Boolean  @default(false)
  destinationId       String? // where the traveller is that day (drives the scroll imagery)
  hotelId             String? // overnight stay, when it is a known Hotel
  accommodationNote   String? // when it isn't: "Overnight on the cruise", "Flight home"
  imageId             String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  package     TourPackage  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  destination Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  hotel       Hotel?       @relation(fields: [hotelId], references: [id], onDelete: SetNull)
  image       Media?       @relation(fields: [imageId], references: [id], onDelete: SetNull)

  @@unique([packageId, dayNumber])
}

model Hotel {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  city        String?
  countryId   String?
  description String?
  starRating  Int? // official category (1-5), not a review score
  website     String?
  imageId     String?
  isSample    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  country       Country?       @relation(fields: [countryId], references: [id], onDelete: SetNull)
  image         Media?         @relation(fields: [imageId], references: [id], onDelete: SetNull)
  packages      PackageHotel[]
  itineraryDays ItineraryDay[]

  @@index([countryId])
}

// Which hotels a package uses, for how long. The same hotel may appear twice
// (e.g. back in Hanoi at the end), so there is no unique(packageId, hotelId).
model PackageHotel {
  id        String  @id @default(cuid())
  packageId String
  hotelId   String
  city      String? // display override, e.g. "Hanoi (return)"
  nights    Int     @default(1)
  roomType  String?
  mealPlan  String? // e.g. "Breakfast included"
  isOption  Boolean @default(false) // "or similar" alternative
  sortOrder Int     @default(0)

  package TourPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  hotel   Hotel       @relation(fields: [hotelId], references: [id], onDelete: Restrict)

  @@index([packageId, sortOrder])
  @@index([hotelId])
}

model PackageInclusion {
  id          String  @id @default(cuid())
  packageId   String
  title       String
  description String?
  sortOrder   Int     @default(0)

  package TourPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId, sortOrder])
}

model PackageExclusion {
  id          String  @id @default(cuid())
  packageId   String
  title       String
  description String?
  sortOrder   Int     @default(0)

  package TourPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId, sortOrder])
}

// ---------------------------------------------------------------------------
// Visa
// ---------------------------------------------------------------------------

// Visa information for travelling TO a country, for holders of ONE passport
// (requirements differ by passport). Unique per destination + passport.
// URL: /visa/{country.slug}/ for the default passport (src/config/site.ts).
model VisaCountry {
  id                String        @id @default(cuid())
  countryId         String
  passportCountryId String
  shortAnswer       String? // answer-first summary for AEO
  description       String?
  importantNotes    String?
  featuredImageId   String?
  lastVerifiedAt    DateTime? // visa rules change; pages show "last checked"
  sourceUrl         String? // official source used for verification
  isSample          Boolean       @default(false)
  status            PublishStatus @default(DRAFT)
  seoId             String?       @unique
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  country         Country       @relation("VisaDestination", fields: [countryId], references: [id], onDelete: Cascade)
  passportCountry Country       @relation("VisaPassport", fields: [passportCountryId], references: [id], onDelete: Restrict)
  featuredImage   Media?        @relation(fields: [featuredImageId], references: [id], onDelete: SetNull)
  seo             SeoMeta?      @relation(fields: [seoId], references: [id], onDelete: SetNull)
  visaTypes       VisaType[]
  packages        TourPackage[]
  faqs            FAQ[]

  @@unique([countryId, passportCountryId])
  @@index([passportCountryId, status])
  @@index([status])
}

// Tourist e-Visa, Business Visa, Transit Visa...
model VisaType {
  id             String               @id @default(cuid())
  visaCountryId  String
  name           String
  slug           String
  purpose        VisaPurpose
  kind           VisaEligibilityKind? // e-Visa, visa on arrival...; null = not verified yet
  description    String?
  eligibility    String?
  processingTime String? // free text: "3-5 working days"
  validity       String?
  maxStay        String?
  entries        String? // "Single" / "Multiple"
  fee            Decimal?             @db.Decimal(12, 2) // government fee; null = not published / varies
  currency       String?              @db.Char(3)
  feeNotes       String?
  importantNotes String?
  sortOrder      Int                  @default(0)
  status         PublishStatus        @default(DRAFT)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  visaCountry  VisaCountry       @relation(fields: [visaCountryId], references: [id], onDelete: Cascade)
  requirements VisaRequirement[]
  steps        VisaProcessStep[]
  faqs         FAQ[]

  @@unique([visaCountryId, slug])
  @@index([visaCountryId, status])
}

// A document or condition needed for a visa type: passport, photo, bank statement...
model VisaRequirement {
  id          String  @id @default(cuid())
  visaTypeId  String
  title       String
  description String?
  required    Boolean @default(true) // false = "recommended" / "if applicable"
  sortOrder   Int     @default(0)

  visaType VisaType @relation(fields: [visaTypeId], references: [id], onDelete: Cascade)

  @@index([visaTypeId, sortOrder])
}

// One step of the application process, in order: "Check eligibility",
// "Prepare documents"... Rendered as the numbered 01, 02, 03 sequence.
model VisaProcessStep {
  id          String  @id @default(cuid())
  visaTypeId  String
  title       String
  description String?
  sortOrder   Int     @default(0)

  visaType VisaType @relation(fields: [visaTypeId], references: [id], onDelete: Cascade)

  @@index([visaTypeId, sortOrder])
}

// ---------------------------------------------------------------------------
// Travel Journal
// ---------------------------------------------------------------------------

// One table for every article type; `category` distinguishes them.
// URL: /travel-journal/{slug}/
model TravelGuide {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  excerpt         String? // answer-first summary
  content         String // markdown
  category        GuideCategory
  destinationId   String?
  countryId       String? // for country-level guides (e.g. visa guides)
  authorId        String?
  featuredImageId String?
  isSample        Boolean       @default(false)
  status          PublishStatus @default(DRAFT)
  publishedAt     DateTime?
  seoId           String?       @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  destination   Destination?  @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  country       Country?      @relation(fields: [countryId], references: [id], onDelete: SetNull)
  author        User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  featuredImage Media?        @relation(fields: [featuredImageId], references: [id], onDelete: SetNull)
  seo           SeoMeta?      @relation(fields: [seoId], references: [id], onDelete: SetNull)
  faqs          FAQ[]
  related       TravelGuide[] @relation("RelatedGuides")
  relatedBy     TravelGuide[] @relation("RelatedGuides")

  @@index([status, publishedAt])
  @@index([category, status])
  @@index([destinationId])
  @@index([countryId])
}

// ---------------------------------------------------------------------------
// FAQs and reviews
// ---------------------------------------------------------------------------

// One FAQ table for the whole site. Each FAQ belongs to at most ONE owner
// (enforced by a CHECK constraint in the migration); none = site-wide FAQ.
model FAQ {
  id            String        @id @default(cuid())
  question      String
  answer        String
  placement     FaqPlacement  @default(DEFAULT)
  packageId     String?
  destinationId String?
  countryId     String?
  guideId       String?
  visaCountryId String?
  visaTypeId    String?
  sortOrder     Int           @default(0)
  isSample      Boolean       @default(false)
  status        PublishStatus @default(DRAFT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  package     TourPackage? @relation(fields: [packageId], references: [id], onDelete: Cascade)
  destination Destination? @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  country     Country?     @relation(fields: [countryId], references: [id], onDelete: Cascade)
  guide       TravelGuide? @relation(fields: [guideId], references: [id], onDelete: Cascade)
  visaCountry VisaCountry? @relation(fields: [visaCountryId], references: [id], onDelete: Cascade)
  visaType    VisaType?    @relation(fields: [visaTypeId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@index([destinationId])
  @@index([countryId])
  @@index([guideId])
  @@index([visaCountryId])
  @@index([visaTypeId])
  @@index([placement, status])
}

// Reviews are only ever entered by staff from real customers. Never seeded.
model Review {
  id               String       @id @default(cuid())
  travellerName    String
  rating           Int // 1-5 (CHECK constraint + Zod)
  title            String?
  content          String
  travellerImageId String?
  travelDate       DateTime?    @db.Date
  packageId        String?
  destinationId    String?
  source           String? // e.g. "Google", "WhatsApp", "Email"
  verified         Boolean      @default(false) // staff confirmed this person travelled with us
  isSample         Boolean      @default(false)
  status           ReviewStatus @default(PENDING)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  travellerImage Media?       @relation(fields: [travellerImageId], references: [id], onDelete: SetNull)
  package        TourPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  destination    Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)

  @@index([packageId, status])
  @@index([destinationId, status])
  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Leads and enquiries (capture only; the CRM arrives in a later phase)
// ---------------------------------------------------------------------------

// A structured trip request ("Plan your trip", package enquiry, visa help).
model Lead {
  id          String     @id @default(cuid())
  name        String
  phone       String
  email       String?
  destination String? // free text as typed by the traveller
  travelDate  DateTime?  @db.Date
  travellers  Int?
  budget      String?
  tripType    String?
  message     String?
  source      String? // utm_source, or "website" / "whatsapp" / "referral"
  medium      String? // utm_medium
  campaign    String? // utm_campaign
  landingPage String? // first page of the visit (path only)
  packageId   String?
  status      LeadStatus @default(NEW)
  notes       String? // internal only, never shown publicly
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  package TourPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([packageId])
  @@index([phone])
}

// A general contact message with no trip details. Kept separate from Lead so
// the sales pipeline isn't cluttered with "where is my invoice?" messages.
model Enquiry {
  id        String        @id @default(cuid())
  name      String
  email     String?
  phone     String?
  subject   String?
  message   String
  source    String? // page or channel it came from
  status    EnquiryStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Site settings (contact details, social links...) - edited in the admin later
// ---------------------------------------------------------------------------

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
